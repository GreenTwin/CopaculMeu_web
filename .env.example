# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.
# Vite inlines these at BUILD time — redeploy after changing them.

# Backend base URL (Railway). Defaults to http://localhost:8080 if unset.
VITE_BACKEND_HOST=https://backend-production-70c5.up.railway.app

# Default data mode for new visitors: live | demo  (defaults to live)
VITE_DEFAULT_MODE=live

# Public Google web client id (GreenTwin project). Not a secret.
# TODO: the Auth Platform user-support email and project contact email are still a personal
# address. Replace both with an official GreenTwin mailbox before publishing the consent screen
# (Google Cloud → GreenTwin → Google Auth Platform → Branding, and the contact email).
VITE_GOOGLE_CLIENT_ID=1029297335817-skdptqienah01t0ve8it0fc7gcvtbkk7.apps.googleusercontent.com
