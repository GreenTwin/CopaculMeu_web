# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.
# Vite inlines these at BUILD time — redeploy after changing them.

# Backend base URL (Railway). Defaults to http://localhost:8080 if unset.
VITE_BACKEND_HOST=https://backend-production-70c5.up.railway.app

# Default data mode for new visitors: live | demo  (defaults to live)
VITE_DEFAULT_MODE=live
